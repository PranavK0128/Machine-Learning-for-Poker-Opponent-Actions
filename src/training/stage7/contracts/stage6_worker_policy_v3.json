  "nested_process_pools_forbidden": true,
  "exclusive_parent_run_lock_required": true,
  "same_host_stale_lock_recovery_required": true,
  "one_independent_lane_per_worker_process_lifetime": true,
  "work_units_must_be_scientifically_disjoint": true,
  "lane_seed_and_checkpoint_identity_independent_of_worker_count_and_completion_order": true,
  "worker_request_is_restart_mutable_and_excluded_from_scientific_run_identity": true,
  "lane_plan_order": "canonical_lane_id_lexical_order",
  "lane_requests_materialized_once_in_canonical_order_before_submit": true,
  "checkpoint_identity_recomputed_from_stage_lane_seed_and_specification_before_resume": true,
  "completed_checkpoint_outside_frozen_plan_must_fail": true,
  "structured_lane_completion_receipt_required": true,
  "completion_receipt_must_bind_stage_lane_seed_identity_path_bytes_and_sha256": true,
  "checkpoint_relative_path_rule": "checkpoints/{checkpoint_identity}.checkpoint",
  "checkpoint_file_must_be_rehashed_from_durable_storage_before_skip": true,
  "completed_lane_payload_release_after_durable_readback": true,
  "parent_collection_after_completed_future": true,
  "linux_malloc_trim_after_lane_when_available": true,
  "checkpoint_generations_retained_per_lane": 1,
  "deterministic_aggregation_order": "canonical_lane_id_lexical_order",
  "aggregation_and_manifest_writes_are_single_writer": true,
  "bounded_one_worker_vs_resolved_parallel_worker_parity_required": true,
  "resource_preflight": {
    "ram_and_disk_measurement_required": true,
    "parent_and_worker_rss_measurement_required": true,
    "estimated_peak_ram_bytes_per_worker": 805306368,
    "minimum_parent_reserve_bytes": 2147483648,
    "minimum_available_disk_bytes": 12884901888,
    "fixed_high_ram_runtime_class_required": false,
    "insufficient_capacity_action": "FAIL_CLOSED_WITH_VISIBLE_CAPACITY_REPORT",
    "silent_worker_reduction_allowed": false,
    "scientific_budget_reduction_allowed": false
  },
  "progress_heartbeat_seconds": 30,
  "progress_fields": [
    "active",
    "queued",
    "completed",
    "remaining",
    "failed",
    "total",
    "throughput_work_units_per_second",
    "eta_seconds",
    "current_phase",
    "checkpoint_identity",
    "rss_bytes",
    "available_system_ram_bytes",
    "available_disk_bytes",
    "cleanup_state"

{
  "schema_version": "stage6_worker_policy_v3",
  "status": "PREREGISTERED_RUNTIME_NEUTRAL_48_LOGICAL_LANE_SUCCESSOR",
  "supersedes_for_new_stage6_notebooks": "stage6_worker_policy_v2",
  "accepted_runtime_types": [
    "cpu",
    "gpu",
    "tpu"
  ],
  "runtime_type_restriction": null,
  "accelerator_required": false,
  "high_ram_runtime_class_required": false,
  "accelerator_kernels_required": false,
  "solver_and_evaluator_cpu_host_processes": true,
  "logical_lane_count": 48,
  "requested_workers_parameter": "STAGE6_REQUESTED_WORKERS",
  "requested_workers_default": "auto",
  "requested_workers_auto_values": [
    null,
    0,
    "",
    "0",
    "auto"
  ],
  "explicit_positive_worker_requests_allowed": true,
  "live_worker_resolution_rule": "min(requested_or_auto_host_cpu_capacity, unfinished_independent_lane_count, detected_usable_logical_cpus, 48)",
  "live_worker_resolution_must_be_reported": true,
  "runtime_name_clipping_forbidden": true,
  "accelerator_device_cores_do_not_count_as_process_workers": true,
  "logical_work_units_must_not_be_reduced": true,

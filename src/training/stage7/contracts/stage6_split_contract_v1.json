      "hand_group_disjoint": true,
      "actor_group_disjoint": true,
      "game_group_disjoint": false,
      "evaluation_actor_must_appear_in_train": false,
      "test_eligible_for_selection": false
    },
    {
      "id": "unseen_game",
      "purpose": "generalization across independent game sessions and table contexts",
      "roles": ["train", "validation", "test"],
      "chronological": false,
      "hand_group_disjoint": true,
      "actor_group_disjoint": false,
      "game_group_disjoint": true,

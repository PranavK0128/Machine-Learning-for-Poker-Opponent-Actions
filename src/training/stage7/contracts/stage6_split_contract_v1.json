    "prelockbox_test_fraction": 0.15,
    "unseen_player_train_actor_bucket_percent": 20,
    "unseen_player_train_hand_sample_percent": 20,
    "unseen_game_hand_sample_percent": 10,
    "hash_rule": "sha256_canonical_json_namespace_and_identity_first_8_bytes_mod_100",

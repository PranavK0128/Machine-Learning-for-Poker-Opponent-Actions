    "hand_interval_order": "min_decision_utc_then_game_id_then_hand_id",
    "boundary_rule": "nearest_strict_global_hand_interval_gap_then_lower_index_tie_break",
    "final_private_lockbox_fraction_of_hands": 0.10,
    "prelockbox_train_fraction": 0.70,

{
  "schema_version": "stage6_group_time_split_contract_v1",
  "status": "PREREGISTERED_CAUSAL_DATA_AVAILABLE__FULL_ASSIGNMENT_HELD",
  "assignment_algorithm": {
    "version": "stage6_group_time_panel_assignment_v1",
